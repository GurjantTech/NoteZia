    <string name="app_name">NoteZia</string>
    <string name="app_subName">तेज़, सुरक्षित और स्मार्ट नोट्स</string>
    <string name="tagline1">आपके नोट्स। आपकी शैली में। तुरंत।</string>
    <string name="tagline2">अब याद रखना हमारा काम है</string>
    <string name="my_notes">मेरे नोट्स</string>
    <string name="onboarding_quote">हर विचार, चाहे कितना भी छोटा क्यों न हो, असाधारण बनने की शक्ति रखता है। अपने विचारों को यूँ ही न जाने दें—उन्हें पकड़ें, व्यवस्थित करें और अपने मन में स्पष्टता लाएँ। आज लिखा गया एक साधारण नोट कल की बड़ी सफलता बन सकता है। चाहे वह कोई क्षणभंगुर विचार हो, कोई महत्वपूर्ण कार्य हो, या कोई व्यक्तिगत चिंतन हो, उसे लिखना विचारों को कार्य में बदलने की दिशा में पहला कदम है। अभी से अपने नोट्स बनाना शुरू करें और अपने विचारों को अपने भविष्य को आकार देने दें।</string>
    <string name="onboarding_quote2">सच कहूँ तो—आपका दिमाग अद्भुत है, लेकिन यह कोई हार्ड ड्राइव नहीं है! उन शानदार विचारों, बेतरतीब विचारों और ज़रूरी कामों को एक सुरक्षित जगह मिलनी चाहिए, इससे पहले कि वे हवा में गायब हो जाएँ। यहीं पर आपके नोट्स काम आते हैं। इन्हें अपने बेकाबू विचारों के लिए छोटे-छोटे जाल समझें। तो इससे पहले कि आपका अगला शानदार विचार हमेशा के लिए अलविदा कहे, उसे लिख लें और अपने भविष्य के स्व को इस स्मार्ट (और व्यवस्थित) होने के लिए धन्यवाद दें।</string>
